function displacement(x,y,s){
 const aMask=smooth((y-220)/65)*(1-smooth((y-460)/90));
 const ra=Math.exp(-Math.pow((x-225)/160,4))*aMask,la=Math.exp(-Math.pow((x-548)/148,4))*aMask;
 let dx=s.atrial*.052*((225-x)*ra+(548-x)*la),dy=s.atrial*.036*(405-y)*(ra+la);
 const mask=smooth((y-495)/115)*(1-smooth((y-1050)/38))*smooth(x/70)*(1-smooth((x-740)/28));
 const septal=365+Math.max(0,y-550)*.18,rv=1-smooth((x-septal+80)/140),lv=smooth((x-septal-5)/145);
 dx+=s.ventricular*mask*(29*rv-37*lv+4*Math.exp(-Math.pow((x-septal)/75,2)));
 dy-=s.ventricular*mask*(10+19*smooth((y-750)/270));return{x:dx,y:dy};
}
function mapped(x,y,s){const d=displacement(x,y,s);return{x:geometry.left+x+d.x,y:geometry.top+y+d.y};}
const tissueCanvas=document.createElement('canvas');tissueCanvas.width=768;tissueCanvas.height=1088;
const tissueCtx=tissueCanvas.getContext('2d'),cells=[];let restingPixels,currentPixels;
const raPoly=[[188,266],[240,272],[304,320],[357,360],[355,420],[321,472],[250,502],[128,512],[96,474],[109,407],[148,324]];
const laPoly=[[503,273],[576,261],[625,291],[652,365],[664,443],[630,478],[541,478],[467,450],[444,392],[453,330]];
const ventPoly=[[153,534],[248,510],[334,500],[401,570],[473,542],[582,503],[653,503],[693,548],[716,672],[711,848],[659,995],[593,1038],[502,1010],[424,953],[308,916],[192,830],[128,700],[119,609]];
function contains(poly,x,y){let yes=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){
 const [xi,yi]=poly[i],[xj,yj]=poly[j];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)yes=!yes;
}return yes;}
function ventricularArrival(x,y){
 if(config.ventricularActivation.origin){const [ox,oy]=config.electrodes.V;return Math.min(150,Math.hypot((x-ox)*.95,y-oy)*.34);}
 // Normal activation is delivered to septal and subendocardial sites by the native system.
 const seeds=[[372,541,0],[355,626,20],[347,789,38],[256,808,48],[179,746,65],[393,862,57],[435,638,24],[611,752,42],[667,693,55],[545,891,55],[644,866,70]];
 return Math.min(85,...seeds.map(([sx,sy,a])=>a+Math.hypot(x-sx,y-sy)*.20));
}
function initCells(){
 for(let y=220;y<1040;y++)for(let x=70;x<735;x++){
  const k=(y*768+x)*4,r=restingPixels[k],g=restingPixels[k+1],b=restingPixels[k+2];
  if(!(r>g*1.12&&r>b*1.18))continue;
  let chamber=contains(raPoly,x,y)?'ra':contains(laPoly,x,y)?'la':contains(ventPoly,x,y)?'v':null;
  if(!chamber)continue;
  let arrival;
  if(chamber==='v')arrival=ventricularArrival(x,y);
  else if(config.abbreviation==='AsVp')arrival=chamber==='ra'?Math.hypot((x-190)*.85,y-277)*.20:35+Math.hypot(x-505,y-328)*.23;
  else arrival=chamber==='ra'?Math.hypot(x-357,y-365)*.25:12+Math.hypot(x-357,y-365)*.22;
  if(chamber!=='v')arrival=Math.min(95,arrival);
  cells.push({k,chamber,arrival});
 }
}
function prepareTissue(s){
 currentPixels=new ImageData(new Uint8ClampedArray(restingPixels),768,1088);
 for(const c of cells){const e=c.chamber==='v'?s.ventricularEvent:s.atrialEvent;if(!e)continue;
  const age=s.ms-(c.chamber==='v'?e.qrsStart:e.pStart)-c.arrival;if(age<0)continue;
  const end=c.chamber==='v'?e.tEnd:e.pStart+230,start=c.chamber==='v'?e.tStart:e.pStart+120;
  if(s.ms>=end)continue;
  const recovery=smooth((s.ms-start)/(end-start)),gain=(.13+.42*Math.exp(-age/22))*(1-recovery);
  const color=[255,219,86];for(let j=0;j<3;j++)currentPixels.data[c.k+j]=restingPixels[c.k+j]*(1-gain)+color[j]*gain;
 }
 tissueCtx.putImageData(currentPixels,0,0);if(meshGPU){const gl=meshGPU.gl;gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,tissueCanvas);}
}
const his=[[333,463],[353,493],[372,541]],rb=[[372,541],[371,586],[354,626],[330,678],[326,734],[347,789]],lb=[[372,541],[396,586],[435,638]];
const fascicles=[[[435,638],[489,684],[540,721],[611,752]],[[435,638],[452,721],[495,812],[545,891]]];
const purkinje=[[[347,789],[315,824],[256,808],[205,760],[164,683]],[[347,789],[355,849],[320,864],[251,830],[179,746]],[[347,789],[393,862],[371,890],[303,868]],[[611,752],[645,757],[667,693],[665,622]],[[611,752],[670,802],[681,733]],[[545,891],[578,940],[644,866]]];
function electrical(s){ctx.save();ctx.shadowColor='#ffd052';ctx.shadowBlur=14;
 const a=s.atrialEvent;
 if(a){const t=s.ms-a.pStart,origin=config.atrialActivation.origin;
  if(t>=0&&t<45)dot(origin,s,'#fff8b0',9*(1-smooth(t/45)));
  if(a.ap===null){pathFront([[190,277],[245,292],[294,321],[365,338],[440,333],[505,328]],s,t,0,65,6);
   pathFront([[190,277],[236,342],[288,412],[333,463]],s,t,0,100,5);}
  else {pathFront([[357,365],[310,350],[270,330],[215,310]],s,t,0,90,5);
   pathFront([[357,365],[400,340],[440,333],[505,328]],s,t,0,90,5);
   pathFront([[357,365],[345,408],[333,463]],s,t,0,100,5);}
  if(t>=100&&t<160){ctx.globalAlpha=1-smooth((t-120)/40);dot([333,463],s,'#fff2a0',10);ctx.globalAlpha=1;}
  if(a.hisStart!==null)pathFront(his,s,s.ms-a.hisStart,0,20,6);
 }
 const v=s.ventricularEvent;
 if(v&&v.vp===null){const t=s.ms-v.qrsStart;for(const p of [rb,lb])pathFront(p,s,t,0,25,6);for(const p of fascicles)pathFront(p,s,t,18,42,5);for(const p of purkinje)pathFront(p,s,t,38,90,4);}
 for(const e of config.timing.events){
  // Capture and sensing are distinct events; no fabricated native SA firing in ApVs.
  for(const [z,site,color] of [[e.ap,config.electrodes.A,'#ffe66f'],[e.vp,config.electrodes.V,'#ffe66f'],[e.as,config.electrodes.A,'#67cce3'],[e.vs,config.electrodes.V,'#67cce3']]){
   if(z!==null&&s.ms>=z&&s.ms<z+42){ctx.globalAlpha=1-smooth((s.ms-z)/42);dot(site,s,color,10);ctx.globalAlpha=1;}
  }
 }
 ctx.restore();
}
let paper;
const components=ms=>PacingModel.components(config,ms),ecgValue=ms=>components(ms).total;
function ecgViewport(ms){const a=config.ecg.panel,t=Math.max(0,Math.min(ms,config.duration.totalSeconds*1000));return{t,offset:t-config.ecg.windowMs/2,cursorX:a.x+a.width/2};}
function drawECG(ms){const a=config.ecg.panel;if(!paper){paper=document.createElement('canvas');paper.width=1808;paper.height=400;const p=paper.getContext('2d');p.fillStyle='white';p.fillRect(0,0,1808,400);
 for(let x=a.x;x<=a.x+a.width;x+=14){p.strokeStyle=Math.round((x-a.x)/14)%5?'#f8e1e4':'#edb7bd';p.beginPath();p.moveTo(x,a.y-1088);p.lineTo(x,a.y+a.height-1088);p.stroke();}
 for(let k=-14;k<=9;k++){const y=a.baseline+k*14;if(y<a.y||y>a.y+a.height)continue;p.strokeStyle=k%5?'#f8e1e4':'#edb7bd';p.beginPath();p.moveTo(a.x,y-1088);p.lineTo(a.x+a.width,y-1088);p.stroke();}}
 ctx.drawImage(paper,0,1088);const {t,offset,cursorX}=ecgViewport(ms);ctx.save();ctx.beginPath();ctx.rect(a.x,a.y,a.width,a.height);ctx.clip();
 for(const future of [true,false]){const from=future?t:Math.max(0,offset),end=future?Math.min(config.duration.totalSeconds*1000,offset+config.ecg.windowMs):t;ctx.strokeStyle=future?'#a7b0b8':'#20282e';ctx.lineWidth=3;ctx.beginPath();
 for(let z=from;z<=end;z+=1){const x=a.x+(z-offset)*a.pxPerMs,y=a.baseline-(components(z).total-components(z).spike)*a.pxPerMv;z===from?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();
 }
 // Explicit spike strokes cannot be skipped by sampling or scale reduction.
 for(const e of config.timing.events)for(const z of [e.ap,e.vp])if(z!==null){const x=a.x+(z-offset)*a.pxPerMs;if(x<a.x||x>a.x+a.width)continue;ctx.strokeStyle=z>t?'#a7b0b8':'#20282e';ctx.lineWidth=2.5;ctx.beginPath();ctx.moveTo(x,a.baseline);ctx.lineTo(x,a.baseline-154);ctx.stroke();}
 ctx.strokeStyle='#bf8a20';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(cursorX,a.y);ctx.lineTo(cursorX,a.y+a.height);ctx.stroke();ctx.restore();ctx.font='bold 29px "BIZ UDPGothic",sans-serif';ctx.fillStyle='#283743';ctx.fillText('II',a.x+8,a.y+29);
}
function render(ms){const s=state(ms);ctx=heartCtx;ctx.reset();ctx.fillStyle='white';ctx.fillRect(0,0,1808,1088);prepareTissue(s);drawMesh(s);electrical(s);ctx=sceneCtx;ctx.reset();ctx.fillStyle='white';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(heartSurface,0,0);if(config.ecg.enabled)drawECG(ms);if(config.ecg.enabled)drawAnnotations(ms);return s;}
window.cardiacAnimation={config,state,displacement,mapped,render,components,ecgValue,ecgViewport,ventricularArrival};window.renderExportTime=render;window.renderExportFrame=i=>render(i*1000/config.duration.fps);
heart.onload=async()=>{try{await document.fonts.ready;tissueCtx.drawImage(heart,0,0,768,1088);restingPixels=tissueCtx.getImageData(0,0,768,1088).data;initCells();initMeshGPU();render(0);window.__CARDIAC_READY__=true;document.getElementById('preparing')?.remove();if(config.ecg.enabled)window.LearnerPlayer.start(render,config.duration.totalSeconds*1000,config.duration.fps,false);}catch(e){document.getElementById('preparing').textContent='読み込みに失敗しました';throw e;}};heart.src=window.HEART_DATA;
</script><script>function drawAnnotations(){if(!window.__ANNOTATIONS_DISABLED__)window.paintPacingAnnotations(ctx,config.abbreviation);}
document.addEventListener('DOMContentLoaded',()=>{const button=document.createElement('button');button.id='annotation-toggle';button.textContent='注釈を隠す';button.onclick=()=>{window.__ANNOTATIONS_DISABLED__=!window.__ANNOTATIONS_DISABLED__;button.textContent=window.__ANNOTATIONS_DISABLED__?'注釈を表示':'注釈を隠す';render(cardiacAnimation.playback.getState().elapsed);};document.querySelector('.diagram-tools').append(button);});
</script>
<section class="ecg-watch"><h2>ApVsの意味と主な特徴</h2><p>「興奮」は心筋の電気的な活動、「伝播」は興奮が周囲へ伝わることです。心臓図の黄色い光は電気的な興奮を示します。収縮はその後に起こります。</p>
<p><strong>ApVsは、ペースメーカーが心房を刺激し、その後に心室の電気信号を読み取る動作を表します。</strong>心房は心臓の上側、心室は下側の部屋です。</p>
<p>ペースメーカーには、心臓の電気信号を読み取る<strong>センシング（感知）</strong>と、電気刺激を出す<strong>ペーシング</strong>という働きがあります。センシングで読み取るのは電気信号です。心臓の筋肉の動きを直接検出しているわけではありません。ペーシングは、心房や心室に電気刺激を送り、拍動を助けることです。</p>
<p>Aは心房、Vは心室、sはセンシング、pはペーシングを表します。<strong>Ap＝心房ペーシング、Vs＝心室センシング</strong>です。AsVp・ApVsは、ペースメーカーが一拍の中で行った動作を表します。病名や装置の設定名ではありません。</p>
<h3>心電図の観察点</h3>
<ol><li><strong>P波とQRSを見つけます。</strong>P波は心房に、QRSは心室に電気信号が広がるときの波です。この図では、P波は小さな山、QRSは大きな波として描いています。</li>
<li><strong>細い縦線（スパイク）の位置を確認します。</strong>スパイクはペースメーカーが刺激を出した印です。この例では、P波の直前にあり、QRSの前にはありません。</li>
<li><strong>スパイクの後に波が続くかを確認します。</strong>心房への刺激に反応して、P波が続いています。</li></ol>
<p><strong>センシングをしただけでは、スパイクは現れません。</strong>図の水色の点は、装置が信号を読み取ったことを示す教材上の表示です。心電図に水色の点が記録されるわけではありません。</p></section>
<section class="ecg-watch revision-annotation-notes"><h3>図の固定注釈</h3><p>この模式例の観察点は「心房に刺激を出す」「心室の信号を感知」です。「P波直前のスパイク」「心室への刺激は出さない」も、下の本文で説明しています。</p></section><section class="ecg-learning-notes"><h2>心房刺激と心室センシングの仕組み</h2><h3>1．調律・状態の特徴</h3><p><strong>ApVsは、ペースメーカーが心房を刺激し、その後に心室の電気信号を読み取る動作を表します。</strong>心房は心臓の上側、心室は下側の部屋です。</p><h3>2．心臓で起こっていること</h3><h4>心臓とペースメーカーの動作の順序</h4>
<p>装置と心臓をつなぐ細い線を<strong>リード</strong>と呼びます。Aリードは心房、Vリードは心室に入っています。図の左側が右心房・右心室です。黄色の発光は電気信号の広がりを示し、その後に筋肉が縮みます。</p>
<ol><li><strong>この例では、心臓自身のリズムが遅くなっています。</strong>設定された時間内に次の心房の信号を検出しなければ、Aリードから心房を刺激します（Ap）。この刺激がスパイクとして現れます。</li><li><strong>刺激に反応して心房が活動します。</strong>心房に電気信号が広がり、スパイクの後にP波が現れます。</li><li><strong>信号が心房から心室へ伝わります。</strong>心室に電気信号が広がり、QRSが現れます。</li><li><strong>Vリードで心室の信号を読み取ります（Vs）。</strong>心室を刺激する予定の時刻より前に信号を検出したため、その拍では心室を刺激しません。QRSの前にスパイクがないのは、このためです。</li></ol>
<p>心房の信号を読み取った後、または心房を刺激した後に、心室の電気信号が現れるのを待つ時間を<strong>AVディレイ（房室遅延時間）</strong>と呼びます。例えば、その時間内に心室の信号を検出すれば、心室への刺激は出しません。その時間内に信号を検出しなければ、心室を刺激します。</p>

<h4>ペースメーカーの設定と動作の関係</h4>
<p>ペースメーカーは、刺激する場所、刺激するタイミング、電気信号の読み取り方などを設定して使用します。設定の名前と、一拍ごとの動作を表すAsVp・ApVsは区別されます。</p>
<h4>動作モード：この教材ではDDD</h4>
<p><strong>モード</strong>は装置の動作方式です。DDDの最初のDは心房と心室の両方を刺激できること、2番目のDは両方の電気信号を読み取れることを表します。3番目のDは、読み取った信号に応じて刺激のタイミングを決めたり、不要な刺激を出さなかったりすることを表します。</p>
<p>例えば、心房の信号を読み取ると、心室を刺激するまでの時間を計り始めます。その間に心室の信号を読み取れば、心室への刺激は出しません。DDDだから毎拍、心房と心室の両方を刺激するわけではありません。同じDDDの設定でも、AsVpにもApVsにもなります。</p>
<h4>基本レート：心臓のリズムが遅いときの刺激</h4>
<p><strong>基本レート（下限レート）</strong>は、拍動を補うための基準となる心拍数です。この教材のようなDDDの基本動作では、設定された間隔内に次の心房の信号を読み取れなければ、心房を刺激します。ApVsでは、この刺激によってP波が現れます。心臓自身の信号をその前に読み取れば、心房への刺激は出しません。実際には、安静時にレートを下げる機能など、ほかの設定も動作に関係します。</p>
<h4>AVディレイ：心室の信号を待つ時間</h4>
<p>心房の信号を読み取った場合と、心房を刺激した場合では、AVディレイを別々に設定できる装置があります。AsVpでは、待つ時間内に心室の信号が検出されず、心室を刺激します。ApVsでは、予定した刺激より前に心室の信号を検出するため、心室への刺激は出ません。心房から心室へ信号が伝わるまでの時間とAVディレイの関係によって、心室を刺激するかどうかが変わる場合があります。</p>
<h4>刺激の強さと持続時間：心臓を反応させるための設定</h4>
<p>刺激の強さを示す<strong>出力電圧</strong>と、刺激を続ける時間を示す<strong>パルス幅</strong>を設定します。刺激を出すタイミングが適切でも、心臓が反応するのに十分な刺激でなければ、スパイクの後にP波やQRSが続かない場合があります。心房・心室それぞれの反応に合わせた設定が必要です。スパイクの見た目の高さだけでは、刺激の強さが適切か判断できません。</p>
<h4>センシング感度：電気信号の検出のしやすさ</h4>
<p><strong>センシング感度</strong>は、心臓の電気信号をどの程度検出しやすくするかを決める設定です。信号を検出しにくい設定では、心臓が活動していても装置が読み取れない場合があります。反対に、検出しやすすぎる設定では、心臓の信号以外の電気的な雑音を読み取る場合があります。感度は刺激の強さとは別の設定です。装置によっては自動的に調整されます。</p>
<p>AsVp・ApVsという表記や体表の心電図だけでは、実際の設定値は分かりません。設定を確認する際は、装置の記録にあるモード、基本レート、AVディレイ、出力、感度と、患者さんの心電図を照らし合わせます。</p>
<h3>3．特徴的な心電図所見</h3><h4>QRSの幅の違い</h4>
<p>この例では、心臓自身の伝導経路を通って心室へ電気信号が広がるため、QRSは狭く描かれています。伝導経路は、電気信号を心室へ伝え、心室全体へ速く広げる通り道です。</p>
<p>この教材では、動作を説明するために一つの例を示しています。心臓の状態や刺激する場所によって、QRSの幅は変わります。AsVpという表記だけで心房から心室へ全く信号が伝わらないとは判断できません。ApVsでも、心室内で電気信号が伝わりにくくなっていればQRSは広くなることがあります。</p>
<h4>AsVpとApVsの比較</h4><div class="ecg-comparison" role="region" tabindex="0" aria-label="AsVpとApVsの比較。狭い画面では横にスクロールできます"><table><thead><tr><th>観察点</th><th>AsVp</th><th>ApVs</th></tr></thead><tbody><tr><th>心房での動作</th><td>As：信号を読み取る</td><td>Ap：刺激を出す</td></tr><tr><th>心室での動作</th><td>Vp：刺激を出す</td><td>Vs：信号を読み取る</td></tr><tr><th>この図のスパイク</th><td>QRSの直前</td><td>P波の直前</td></tr><tr><th>この例の心房から心室への伝わり方</th><td>伝わらない</td><td>伝わる</td></tr></tbody></table></div><p><a href="asvp.html">AsVpのアニメーションと比較する</a></p>
<h3>4．患者さんへの影響と看護</h3><h4>患者さんの観察と刺激後の反応</h4>
<p>刺激によって心房や心室が電気的に反応することを<strong>捕捉（ほそく）</strong>といいます。心房を刺激したときのスパイクの後にP波、心室を刺激したときのスパイクの後にQRSが続くかが、確認の手掛かりです。例えば、心室を刺激したときのスパイクがあってもQRSが続かなければ、刺激を出しても、心室が反応していない可能性があります。スパイクの有無だけでは、装置が正常に働いているか判断できません。</p>
<p>電気的に反応していても、十分に血液を送り出せているかは心電図だけでは分かりません。患者さんの意識や症状、脈拍、血圧を合わせて確認します。めまい・息苦しさなどの症状や刺激後の波形に変化があれば、症状、脈拍・血圧、心電図の変化を伝え、施設の手順に沿って相談・報告します。装置が適切に動作しているかを調べるには、設定や保存された記録も確認する必要があります。</p>
<details><summary>図と実際の心電図の違い・補足</summary><p>この図は学習用の模式図で、形や動きを分かりやすく簡略化しています。Aリード先端は左右の心房を隔てる壁の右心房側、Vリード先端は左右の心室を隔てる壁の右心室側に置いています。留置位置の一例です。</p><p>スパイクは見つけやすく大きく描いています。実際には、記録方法によってスパイクが小さく、見えにくいこともあります。体表の心電図だけでは、装置が電気信号を正しく読み取れたか判断できない場合があります。As・Vsなどの表示や装置の記録も確認します。</p><p>QRSの後のT波は、心室が電気的に回復する過程を示す波です。新たな刺激の印ではありません。心電図は電気活動の記録であり、収縮そのものを記録しているわけではありません。</p><p>同じ患者さんでも、心臓の状態や装置の設定によって、一拍ごとの動作は変わることがあります。QRSの形だけでリードの位置や病気の原因は判断できません。</p></details>
<details><summary>参考資料・確認状況</summary><ul><li><a href="https://manuals.eifu.abbott/content/dam/av/manuals-eifu/global/US/en/60033180_.pdf">Abbottの説明書：AsVp・ApVsの定義と装置の動作</a></li><li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5067035/">刺激後の反応とペースメーカーの動作の確認</a></li><li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12378894/">学会資料：リードの留置位置</a></li></ul><p>対象者：看護師1～2年目。資料確認日：2026年10月13日。専門家レビュー、実機確認、対象者による理解度確認は未実施です。</p></details><h3>5．学習の要点</h3><p>心房を刺激し、その後に心室の電気信号を読み取ります。この例ではP波の直前にスパイクがあり、その後にP波が続きます。心室の信号を読み取るため、その拍では心室を刺激しません。</p></section>
<section class="ecg-remember"><h2>学習の要点</h2><p><strong>ApVs：心房はペーシング、心室はセンシング。この図ではP波の直前にスパイクがあります。</strong></p><p>観察では、刺激した場所と、刺激の後にP波・QRSが続くかを確認します。患者さんの状態と合わせた評価が必要です。</p></section><section class="ecg-learning-common" aria-labelledby="ecg-learning-common-title"><h3 id="ecg-learning-common-title">共通の学習内容</h3><p>心電図の波形は、心臓のどこに、どの順番で電気的な興奮が広がったかを反映しています。心臓図と波形を対応させることで、所見が現れる理由を理解できます。</p><p>心電図は電気活動の記録であり、収縮や血液の送り出しを直接記録するものではありません。患者さんの状態は、症状、脈拍・血圧・呼吸など、以前の心電図と合わせて評価します。</p></section></main></body><link rel="stylesheet" href="explanation-review.css?v=20261013"><link rel="stylesheet" href="category-pacing.css?v=pacing-20261014"></html>