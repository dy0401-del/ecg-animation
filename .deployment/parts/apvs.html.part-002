  function drawImageTriangle(context, image, source, destination) {
    const s0 = source[0];
    const s1 = source[1];
    const s2 = source[2];
    const d0 = destination[0];
    const d1 = destination[1];
    const d2 = destination[2];
    const sx1 = s1.x - s0.x;
    const sy1 = s1.y - s0.y;
    const sx2 = s2.x - s0.x;
    const sy2 = s2.y - s0.y;
    const determinant = sx1 * sy2 - sx2 * sy1;
    if (Math.abs(determinant) < 0.000001) return;
    const dx1 = d1.x - d0.x;
    const dy1 = d1.y - d0.y;
    const dx2 = d2.x - d0.x;
    const dy2 = d2.y - d0.y;
    const a = (dx1 * sy2 - dx2 * sy1) / determinant;
    const c = (dx2 * sx1 - dx1 * sx2) / determinant;
    const b = (dy1 * sy2 - dy2 * sy1) / determinant;
    const d = (dy2 * sx1 - dy1 * sx2) / determinant;
    const e = d0.x - a * s0.x - c * s0.y;
    const f = d0.y - b * s0.x - d * s0.y;
    // Subpixel overlap prevents antialiased cracks between moving mesh triangles.
    const center = { x: (d0.x + d1.x + d2.x) / 3, y: (d0.y + d1.y + d2.y) / 3 };
    const edge = [d0, d1, d2].map(point => {
      const dx = point.x - center.x, dy = point.y - center.y;
      const factor = 0.7 / Math.max(1, Math.hypot(dx, dy));
      return { x: point.x + dx * factor, y: point.y + dy * factor };
    });
    context.save();
    context.beginPath();
    context.moveTo(edge[0].x, edge[0].y);
    context.lineTo(edge[1].x, edge[1].y);
    context.lineTo(edge[2].x, edge[2].y);
    context.closePath();
    context.clip();
    context.transform(a, b, c, d, e, f);
    context.drawImage(image, 0, 0);
    context.restore();
  }


function drawMeshFallback(s){
  const rows=config.visual.meshRows,cols=config.visual.meshColumns,v=[];
  for(let r=0;r<=rows;r++){const a=[];for(let c=0;c<=cols;c++){const x=c*768/cols,y=r*1088/rows;a.push({source:{x,y},destination:mapped(x,y,s)});}v.push(a);}
  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){
    const a=v[r][c],b=v[r][c+1],d=v[r+1][c],e=v[r+1][c+1];
    for(const tri of [[a,b,e],[a,e,d]])drawImageTriangle(ctx,tissueCanvas,tri.map(p=>p.source),tri.map(p=>p.destination));
  }
}
// GPU rasterization of the same local displacement mesh. This keeps the
// educational front traceable during real-time playback rather than skipping
// most of a 200 ms revolution in thousands of Canvas2D triangle draws.
let meshGPU=null;
function initMeshGPU(){
  const surface=document.createElement('canvas');surface.width=768;surface.height=1088;
  const gl=surface.getContext('webgl',{alpha:true,premultipliedAlpha:false,preserveDrawingBuffer:true,antialias:false});
  if(!gl)return;
  const shader=(type,source)=>{const s=gl.createShader(type);gl.shaderSource(s,source);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(s));return s;};
  const program=gl.createProgram();
  gl.attachShader(program,shader(gl.VERTEX_SHADER,'attribute vec2 position;attribute vec2 uv;varying vec2 vUV;void main(){vUV=uv;gl_Position=vec4(position.x/384.0-1.0,1.0-position.y/544.0,0.0,1.0);}'));
  gl.attachShader(program,shader(gl.FRAGMENT_SHADER,'precision mediump float;varying vec2 vUV;uniform sampler2D image;void main(){gl_FragColor=texture2D(image,vUV);}'));
  gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(program));gl.useProgram(program);
  const rows=config.visual.meshRows,cols=config.visual.meshColumns,coords=[],uv=[],indices=[];
  for(let r=0;r<=rows;r++)for(let c=0;c<=cols;c++){coords.push([c*768/cols,r*1088/rows]);uv.push(c/cols,r/rows);}
  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){const a=r*(cols+1)+c,b=a+1,d=a+cols+1,e=d+1;indices.push(a,b,e,a,e,d);}
  const positions=new Float32Array(coords.length*2),posBuffer=gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER,posBuffer);gl.bufferData(gl.ARRAY_BUFFER,positions.byteLength,gl.DYNAMIC_DRAW);
  const loc=gl.getAttribLocation(program,'position');gl.enableVertexAttribArray(loc);gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
  gl.bindBuffer(gl.ARRAY_BUFFER,gl.createBuffer());gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(uv),gl.STATIC_DRAW);
  const uvLoc=gl.getAttribLocation(program,'uv');gl.enableVertexAttribArray(uvLoc);gl.vertexAttribPointer(uvLoc,2,gl.FLOAT,false,0,0);
  gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,gl.createBuffer());gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(indices),gl.STATIC_DRAW);
  const texture=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,texture);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
  gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,heart);
  gl.viewport(0,0,768,1088);
  meshGPU={surface,gl,coords,positions,posBuffer,count:indices.length};
}
function drawMesh(s){
  if(!meshGPU){drawMeshFallback(s);return;}
  const {gl,surface,coords,positions,posBuffer,count}=meshGPU;
  for(let i=0;i<coords.length;i++){const [x,y]=coords[i],d=displacement(x,y,s);positions[i*2]=x+d.x;positions[i*2+1]=y+d.y;}
  gl.bindBuffer(gl.ARRAY_BUFFER,posBuffer);gl.bufferSubData(gl.ARRAY_BUFFER,0,positions);
  gl.clear(gl.COLOR_BUFFER_BIT);gl.drawElements(gl.TRIANGLES,count,gl.UNSIGNED_SHORT,0);
  ctx.drawImage(surface,geometry.left,geometry.top);
}
function line(points,s,color,width){ctx.beginPath();points.forEach(([x,y],i)=>{const p=mapped(x,y,s);i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y)});ctx.strokeStyle=color;ctx.lineWidth=width;ctx.lineCap='round';ctx.lineJoin='round';ctx.stroke();}
function pointOnPath(points,p){const lens=points.slice(1).map((q,i)=>Math.hypot(q[0]-points[i][0],q[1]-points[i][1]));let d=clamp(p)*lens.reduce((a,b)=>a+b,0);for(let i=0;i<lens.length;i++){if(d<=lens[i])return points[i].map((v,k)=>v+(points[i+1][k]-v)*d/lens[i]);d-=lens[i];}return points.at(-1);}
function pathFront(points,s,t,a,b,width=7,color='#fff5ad'){
  if(t<a||t>b)return;const p=(t-a)/(b-a);
  line(Array.from({length:13},(_,i)=>pointOnPath(points,Math.max(0,p-.22)+Math.min(.22,p)*i/12)),s,color,width);
}
function dot(point,s,color,r){const p=mapped(...point,s);ctx.beginPath();ctx.arc(p.x,p.y,r,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();}


'use strict';
const config=window.RhythmConfig,canvas=document.getElementById('scene'),sceneCtx=canvas.getContext('2d',{willReadFrequently:true}),heart=new Image(),geometry=config.anatomy;
const heartSurface=document.createElement('canvas');heartSurface.width=1808;heartSurface.height=1088;
const heartCtx=heartSurface.getContext('2d',{willReadFrequently:true});let ctx=sceneCtx;
const {clamp,smooth,envelope}=PacingModel;
