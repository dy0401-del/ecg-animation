","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"];
// Educational analytic model, in mV and milliseconds; not a patient tracing.
const ECG={pStart:20,pEnd:120,qrsStart:220,qrsEnd:310,tStart:450,tEnd:620,rr:1000,seconds:5,
 leads:['I','II','III','aVR','aVL','aVF','V1','V2','V3','V4','V5','V6'],
 chest:[ [.08,0,.20,-.85,.13],[.10,0,.40,-1.05,.24],[.11,0,.75,-.75,.36],[.12,-.035,1.10,-.35,.44],[.11,-.045,1.40,-.16,.40],[.10,-.04,1.50,-.08,.34] ]};
function bump(t,a,b){if(t<=a||t>=b)return 0;return Math.sin(Math.PI*(t-a)/(b-a))**2;}
function components(t){return [bump(t,20,120),bump(t,220,238),bump(t,234,268),bump(t,262,310),bump(t,450,620)];}
function ecgValue(lead,ms){const t=((ms%1000)+1000)%1000,b=components(t);const dot=a=>a.reduce((s,v,i)=>s+v*b[i],0);
 const I=dot([.13,-.035,.72,-.11,.25]),II=dot([.20,-.025,1.02,-.18,.34]);
 if(lead==='I')return I;if(lead==='II')return II;if(lead==='III')return II-I;if(lead==='aVR')return -(I+II)/2;if(lead==='aVL')return I-II/2;if(lead==='aVF')return II-I/2;
 const i=ECG.leads.indexOf(lead)-6;let v=dot(ECG.chest[i]);if(i===0)v+=.04*bump(t,20,68)-.055*bump(t,68,120);return v;
}
let ecgPaper,ecgInk;
function makePaper(){
 ecgPaper=document.createElement('canvas');ecgPaper.width=2400;ecgPaper.height=1488;const p=ecgPaper.getContext('2d');
 ecgInk=document.createElement('canvas');ecgInk.width=2400;ecgInk.height=1488;const ink=ecgInk.getContext('2d');
 for(let col=0;col<2;col++)for(let row=0;row<6;row++){
 const x=1120+col*630,y=280+row*177,w=550,h=158,base=y+95;
 p.fillStyle='#fffdfc';p.fillRect(x,y,w,h);
 for(let k=0;k<=125;k++){p.strokeStyle=k%5?'#f4e5e5':'#e6c5c8';p.lineWidth=k%5?.65:1;p.beginPath();p.moveTo(x+k*4.4,y);p.lineTo(x+k*4.4,y+h);p.stroke();}
 for(let k=-21;k<=14;k++){const gy=base+k*4.4;if(gy<y||gy>y+h)continue;p.strokeStyle=k%5?'#f4e5e5':'#e6c5c8';p.lineWidth=k%5?.65:1;p.beginPath();p.moveTo(x,gy);p.lineTo(x+w,gy);p.stroke();}
 const lead=ECG.leads[col*6+row];p.font='bold 29px "Yu Gothic",Meiryo';p.fillStyle='#283743';p.fillText(lead,x-65,y+38);
 for(const [target,color] of [[p,'#919da5'],[ink,'#203b49']]){target.strokeStyle=color;target.lineWidth=2.3;target.lineJoin='round';target.beginPath();for(let t=0;t<=5000;t++){const px=x+t*.11,py=base-ecgValue(lead,t)*44;t?target.lineTo(px,py):target.moveTo(px,py)}target.stroke();}
 }
}
function drawECG(ms){if(!ecgPaper)makePaper();ctx.drawImage(ecgPaper,0,0);const clock=((ms%5000)+5000)%5000;
 for(let i=0;i<12;i++){const col=Math.floor(i/6),row=i%6,x=1120+col*630,y=280+row*177,base=y+95;
 ctx.save();ctx.beginPath();ctx.rect(x,y,clock*.11,158);ctx.clip();ctx.drawImage(ecgInk,0,0);ctx.restore();
 ctx.strokeStyle='#bf8a20';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(x+clock*.11,y);ctx.lineTo(x+clock*.11,y+158);ctx.stroke();
 }
 text('肢誘導',1055,232,29);text('胸部誘導',1685,232,29);
 text('25 mm/秒相当・10 mm/mV相当　｜　1大マス＝0.20秒／0.5 mV',1055,1404,24,'#52616c');
 text('0',1120,1370,21);text('5秒',1627,1370,21);text('0',1750,1370,21);text('5秒',2257,1370,21);
}
function labels(s){
 text('正常洞調律  ×  12誘導心電図',180,102,48);text('HR 60回/分　｜　RR 1.00秒　｜　5秒・5拍',180,158,29,'#52616c');
 text('右房',230,495,27);text('左房',868,480,27);text('右室',259,1210,29);text('左室',847,1250,29);
 const t=s.t,phase=t<20?'拡張期':t<120?'心房興奮：P波':t<200?'房室結節遅延：PR区間':t<220?'His束へ伝導：PR終末':t<310?'心室興奮：QRS波':t<450?'心室収縮：ST区間':t<620?'心室再分極：T波':'弛緩・拡張期';
 text(phase,180,1340,30,'#9b6919');text('黄色：興奮　青緑：再分極',180,1394,25,'#52616c');
 text('PR 200 ms　｜　QRS 90 ms　｜　QT 400 ms',1055,154,28,'#52616c');
 text('正常範囲を示す模式波形 ／ 縦線は心臓と共通の現在時刻',1055,193,23,'#687780');
}

const canvas=document.getElementById('scene'),ctx=canvas.getContext('2d');
const config={id:'sinus-v26-golden',duration:{fps:60,totalSeconds:5},heartRate:60,visual:{width:2400,height:1488,playbackRate:1},
 heartSource:'正常洞調律_Ⅱ誘導同期_v24.html',ecgSource:'正常洞調律_12誘導同期_v25_stage2.html',
 sourceFrameCount:120,
 // [output milliseconds, original v24 cycle milliseconds]. Image pixels untouched.
 heartTimeMap:[[0,0],[20,37.5],[120,217.1],[200,325],[220,465],[310,660],[450,680],[620,830],[850,975],[1000,1000]]};
const frames=window.HEART_FRAMES.map(()=>new Image());
function sourceTime(t){const a=config.heartTimeMap;for(let i=1;i<a.length;i++)if(t<=a[i][0]){const [x0,y0]=a[i-1],[x1,y1]=a[i];return y0+(y1-y0)*(t-x0)/(x1-x0)}return 0;}
function frameAt(ms){const t=((ms%1000)+1000)%1000;return Math.min(119,Math.floor(sourceTime(t)*.12));}
function state(ms){return{ms,t:((ms%1000)+1000)%1000,sourceFrame:frameAt(ms)};}
function text(str,x,y,size,color='#283743'){ctx.font=`${size}px "BIZ UDPGothic","Yu Gothic",Meiryo,sans-serif`;ctx.fillStyle=color;ctx.fillText(str,x,y);}
function render(ms){const s=state(ms);ctx.fillStyle='#F8FAFC';ctx.fillRect(0,0,2400,1488);ctx.drawImage(frames[s.sourceFrame],180,210,768,1088);labels(s);drawECG(ms);return s;}
let playbackRate=1,elapsed=0,last=null,playing=true;
function loop(now){if(last!==null&&playing)elapsed+=(now-last)*playbackRate;last=now;render(elapsed);requestAnimationFrame(loop);}
document.getElementById('speed').onchange=e=>playbackRate=Number(e.target.value);
document.getElementById('pause').onclick=e=>{playing=!playing;e.target.textContent=playing?'一時停止':'再生'};
document.getElementById('restart').onclick=()=>{elapsed=0;last=null;render(0)};
window.renderExportTime=render;window.renderExportFrame=i=>render(i*1000/60);
window.cardiacAnimation={config,state,sourceTime,frameAt,render,ecgValue,ECG};config.ecg=ECG;
Promise.all(frames.map((im,i)=>new Promise((resolve,reject)=>{im.onload=resolve;im.onerror=reject;im.src=window.HEART_FRAMES[i]}))).then(()=>{render(0);window.__CARDIAC_READY__=true;if(!location.search.includes('mode=export'))requestAnimationFrame(loop)});
</script></html>